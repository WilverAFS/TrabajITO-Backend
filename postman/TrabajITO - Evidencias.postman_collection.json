		{
			"name": "05 - Usuario sin permisos",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(",
							"    \"HTTP 403\",",
							"    () => pm.response.to.have.status(403)",
							");",
							"",
							"const b = pm.response.json();",
							"",
							"pm.test(",
							"    \"Operacion rechazada\",",
							"    () => pm.expect(",
							"        b.success",
							"    ).to.eql(false)",
							");",
							"",
							"pm.test(",
							"    \"Codigo de error correcto\",",
							"    () => pm.expect(",
							"        b.error_code",
							"    ).to.eql(",
							"        \"EVIDENCE_ACCESS_DENIED\"",
							"    )",
							");",
							"",
							"pm.test(",
							"    \"Mensaje presente\",",
							"    () => pm.expect(",
							"        b.message",
							"    ).to.be.a(\"string\").and.not.empty",
							");"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
