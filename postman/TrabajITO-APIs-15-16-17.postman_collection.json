                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "API 16 - Disponibilidad",
      "description": "Registro, consulta, actualización, validación de superposición y eliminación de horarios.",
      "item": [
        {
          "name": "01 - Registrar disponibilidad",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/perfil/disponibilidades",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "perfil",
                "disponibilidades"
              ]
            },
            "description": "Registra disponibilidad para lunes de 09:00 a 12:00.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dia_semana\": 1,\n  \"hora_inicio\": \"09:00\",\n  \"hora_fin\": \"12:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201 - Disponibilidad registrada\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"Registro exitoso\", () => pm.expect(b.success).to.eql(true));",
                  "pm.test(\"Día y horario correctos\", () => { pm.expect(b.data.dia_semana).to.eql(1); pm.expect(b.data.hora_inicio).to.eql(\"09:00:00\"); pm.expect(b.data.hora_fin).to.eql(\"12:00:00\"); });",
                  "pm.collectionVariables.set(\"idDisponibilidad\", String(b.data.id_disponibilidad));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Consultar disponibilidades propias",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/perfil/disponibilidades",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "perfil",
                "disponibilidades"
              ]
            },
            "description": "Consulta los horarios del trabajador autenticado."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 - Disponibilidades consultadas\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Consulta exitosa y lista\", () => { pm.expect(b.success).to.eql(true); pm.expect(b.data).to.be.an(\"array\"); });",
                  "pm.test(\"Incluye la disponibilidad creada\", () => pm.expect(b.data.map(x => String(x.id_disponibilidad))).to.include(pm.collectionVariables.get(\"idDisponibilidad\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Actualizar disponibilidad",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/perfil/disponibilidades/{{idDisponibilidad}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "perfil",
                "disponibilidades",
                "{{idDisponibilidad}}"
              ]
            },
            "description": "Actualiza el horario a 13:00-16:00 y cambia su estado a inactivo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hora_inicio\": \"13:00\",\n  \"hora_fin\": \"16:00\",\n  \"activo\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 - Disponibilidad actualizada\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Actualización exitosa\", () => pm.expect(b.success).to.eql(true));",
                  "pm.test(\"Horario actualizado\", () => { pm.expect(b.data.hora_inicio).to.eql(\"13:00:00\"); pm.expect(b.data.hora_fin).to.eql(\"16:00:00\"); });",
                  "pm.test(\"Estado inactivo\", () => pm.expect(b.data.activo).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Rechazar disponibilidad superpuesta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/perfil/disponibilidades",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "perfil",
                "disponibilidades"
              ]
            },
            "description": "Intenta crear un horario 14:00-15:00 que se superpone con el intervalo 13:00-16:00. Debe responder HTTP 422.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dia_semana\": 1,\n  \"hora_inicio\": \"14:00\",\n  \"hora_fin\": \"15:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422 - Superposición rechazada\", () => pm.response.to.have.status(422));",
                  "const b = pm.response.json();",
                  "pm.test(\"Código VALIDATION_ERROR\", () => pm.expect(b.error_code).to.eql(\"VALIDATION_ERROR\"));",
                  "pm.test(\"Conflicto indicado en hora_inicio\", () => pm.expect(b.errors).to.have.property(\"hora_inicio\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Eliminar disponibilidad",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/perfil/disponibilidades/{{idDisponibilidad}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "perfil",
                "disponibilidades",
                "{{idDisponibilidad}}"
              ]
            },
            "description": "Elimina la disponibilidad creada. Respuesta esperada: HTTP 204 sin cuerpo."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204 - Disponibilidad eliminada\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Rechazar eliminación de disponibilidad inexistente",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/perfil/disponibilidades/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "perfil",
                "disponibilidades",
                "999999"
              ]
            },
            "description": "Debe responder HTTP 404 con AVAILABILITY_NOT_FOUND."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404 - Disponibilidad inexistente\", () => pm.response.to.have.status(404));",
                  "const b = pm.response.json();",
                  "pm.test(\"Código AVAILABILITY_NOT_FOUND\", () => pm.expect(b.error_code).to.eql(\"AVAILABILITY_NOT_FOUND\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "API 17 - Certificados",
      "description": "Registro multipart/form-data, consulta y eliminación de certificados.",
      "item": [
        {
          "name": "01 - Registrar certificado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/perfil/certificados",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "perfil",
                "certificados"
              ]
            },
            "description": "Solicitud multipart/form-data. Selecciona un archivo PDF, JPG, JPEG o PNG de máximo 5 MB en el campo documento. No agregues Content-Type manualmente; Postman debe generar el boundary.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "nombre",
                  "value": "Certificado de instalaciones eléctricas",
                  "type": "text"
                },
                {
                  "key": "institucion_emisora",
                  "value": "Institución de capacitación de prueba",
                  "type": "text"
                },
                {
                  "key": "fecha_emision",
                  "value": "2025-05-15",
                  "type": "text"
                },
                {
                  "key": "documento",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201 - Certificado registrado\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"Registro exitoso\", () => pm.expect(b.success).to.eql(true));",
                  "pm.test(\"Nombre correcto\", () => pm.expect(b.data.nombre).to.eql(\"Certificado de instalaciones eléctricas\"));",
                  "pm.test(\"Inicia sin verificar\", () => pm.expect(b.data.verificado).to.eql(false));",
                  "pm.test(\"URL del documento generada\", () => pm.expect(b.data.documento_url).to.be.a(\"string\").and.match(/^\\/storage\\/certificados\\//));",
                  "pm.test(\"No expone ruta interna\", () => pm.expect(b.data).to.not.have.property(\"ruta_documento\"));",
                  "pm.collectionVariables.set(\"idCertificado\", String(b.data.id_certificado));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Consultar certificados propios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/perfil/certificados",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "perfil",
                "certificados"
              ]
            },
            "description": "Consulta los certificados del trabajador autenticado."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 - Certificados consultados\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Consulta exitosa y lista\", () => { pm.expect(b.success).to.eql(true); pm.expect(b.data).to.be.an(\"array\"); });",
                  "pm.test(\"Incluye el certificado creado\", () => pm.expect(b.data.map(x => String(x.id_certificado))).to.include(pm.collectionVariables.get(\"idCertificado\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Eliminar certificado",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/perfil/certificados/{{idCertificado}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "perfil",
                "certificados",
                "{{idCertificado}}"
              ]
            },
            "description": "Elimina el certificado y el documento almacenado. Respuesta esperada: HTTP 204."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204 - Certificado eliminado\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Rechazar eliminación de certificado inexistente",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/perfil/certificados/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "perfil",
                "certificados",
                "999999"
              ]
            },
            "description": "Debe responder HTTP 404 con CERTIFICATE_NOT_FOUND."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404 - Certificado inexistente\", () => pm.response.to.have.status(404));",
                  "const b = pm.response.json();",
                  "pm.test(\"Código CERTIFICATE_NOT_FOUND\", () => pm.expect(b.error_code).to.eql(\"CERTIFICATE_NOT_FOUND\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
