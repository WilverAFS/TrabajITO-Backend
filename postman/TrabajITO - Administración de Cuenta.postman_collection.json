						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"correo\": \"{{correoPrueba}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/auth/forgot-password",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"auth",
						"forgot-password"
					]
				},
				"description": "POST http://127.0.0.1:8000/api/v1/auth/forgot-password\n\nDespués de ejecutar esta solicitud:\n1. Revisar storage/logs/laravel.log\n2. Obtener el token generado por Laravel\n3. Guardarlo en la variable resetToken\n4. Continuar con la siguiente solicitud"
			},
			"response": []
		},
		{
			"name": "05 - Restablecer contraseña",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('HTTP 200', () => pm.response.to.have.status(200));",
							"const b = pm.response.json();",
							"pm.test('Restablecimiento exitoso', () => pm.expect(b.success).to.eql(true));",
							"pm.collectionVariables.set('passwordActual', 'Reset12345!');"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"correo\": \"{{correoPrueba}}\",\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"{{paswordReset}}\",\n  \"password_confirmation\": \"{{paswordReset}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
