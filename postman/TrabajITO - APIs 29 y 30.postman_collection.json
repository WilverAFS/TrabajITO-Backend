				{
					"name": "01 - Login administrador",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('HTTP 200', () => pm.response.to.have.status(200));",
									"const b = pm.response.json();",
									"pm.test('Login exitoso', () => pm.expect(b.success).to.eql(true));",
									"pm.collectionVariables.set('authToken', b.data.token);"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
