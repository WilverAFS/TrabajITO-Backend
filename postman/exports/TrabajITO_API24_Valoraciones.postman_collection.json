    {
      "name": "05 - Crear valoración correctamente (201)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/publicaciones/{{id_publicacion}}/valoracion",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"calificacion\":5,\"comentario\":\"Excelente servicio, trabajo terminado correctamente.\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Creación devuelve 201', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.test('Valoración creada correctamente', function () { pm.expect(json.success).to.eql(true); pm.expect(json.data.calificacion).to.eql(5); });",
              "pm.test('Devuelve ID de valoración', function () { pm.expect(json.data.id_valoracion).to.be.a('number'); });",
              "if (json.data && json.data.id_valoracion) { pm.environment.set('id_valoracion', String(json.data.id_valoracion)); }"
            ]
          }
        }
      ]
    },
